[Unit]
Description=RCPU Daemon
After=network.target

[Service]
Type=forking
ExecStart=/usr/local/bin/rcpud -chain=rcpu -datadir=/root/.rcpu -daemon
ExecStop=/usr/local/bin/rcpu-cli -chain=rcpu -datadir=/root/.rcpu stop
Restart=always
RestartSec=10
LimitNOFILE=65536
OOMScoreAdjust=-500

[Install]
WantedBy=multi-user.target
